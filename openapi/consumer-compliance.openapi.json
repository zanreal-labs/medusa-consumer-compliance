{
  "openapi": "3.1.0",
  "info": {
    "title": "@zanreal/medusa-consumer-compliance Store API",
    "version": "0.1.0",
    "description": "Store API routes added by the plugin, plus the cart completion behaviour it enforces. Not legal advice."
  },
  "servers": [
    {
      "url": "https://your-medusa-backend"
    }
  ],
  "paths": {
    "/store/products/{id}/compliance": {
      "get": {
        "summary": "Product page compliance data",
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "region_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Pricing context: region (its currency). Or pass currency_code."
          },
          {
            "name": "currency_code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Pricing context without a region."
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "pl or en."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "product_id": {
                      "type": "string"
                    },
                    "variants": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/VariantCompliance"
                      }
                    },
                    "safety": {
                      "$ref": "#/components/schemas/Safety"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown or not visible product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/store/consumer-compliance/variants": {
      "get": {
        "summary": "Compliance data for up to 100 variants",
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Comma separated variant ids"
          },
          {
            "name": "region_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Pricing context: region (its currency). Or pass currency_code."
          },
          {
            "name": "currency_code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Pricing context without a region."
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "pl or en."
          },
          {
            "name": "reduction_started_at",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ISO date: evaluate a reduction that is not a price list (discount code campaign)."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "variants": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/VariantCompliance"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/store/consumer-compliance/variants/{id}/omnibus": {
      "get": {
        "summary": "One variant's Omnibus block",
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "region_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Pricing context: region (its currency). Or pass currency_code."
          },
          {
            "name": "currency_code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Pricing context without a region."
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "pl or en."
          },
          {
            "name": "reduction_started_at",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ISO date, as above."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "variant_id": {
                      "type": "string"
                    },
                    "currency_code": {
                      "type": "string"
                    },
                    "tax_inclusive": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "omnibus": {
                      "$ref": "#/components/schemas/Omnibus"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown variant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/store/consumer-compliance/disclosures": {
      "get": {
        "summary": "Disclosure texts and withdrawal labels",
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "pl or en."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Disclosures"
                }
              }
            }
          }
        }
      }
    },
    "/store/consumer-compliance/carts/{id}/consents": {
      "get": {
        "summary": "Consents that apply to the cart",
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "pl or en."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartConsents"
                }
              }
            }
          },
          "404": {
            "description": "Unknown cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Record acceptances on the cart",
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptConsents"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartConsents"
                }
              }
            }
          },
          "400": {
            "description": "Consent does not apply, cart completed, or `consent_version_outdated`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/store/carts/{id}/complete": {
      "post": {
        "summary": "Medusa cart completion (blocked by this plugin when consents are missing)",
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Medusa's response: { type: 'order', order } or { type: 'cart', cart, error }"
          },
          "400": {
            "description": "`consent_required` or `consent_version_outdated`; message ends with the consent keys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/store/consumer-compliance/withdrawals/lookup": {
      "post": {
        "summary": "Withdrawal eligibility for an order",
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderReference"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WithdrawalLookup"
                }
              }
            }
          },
          "404": {
            "description": "No order matches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/store/consumer-compliance/withdrawals": {
      "post": {
        "summary": "Withdrawal step one: the statement",
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WithdrawalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created, pending confirmation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "withdrawal": {
                      "$ref": "#/components/schemas/Withdrawal"
                    },
                    "confirmation_token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Not allowed (excluded items, canceled order, `external_marketplace_order`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No order matches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "The logged-in customer's withdrawals",
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "customer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "withdrawals": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Withdrawal"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/store/consumer-compliance/withdrawals/{id}/confirm": {
      "post": {
        "summary": "Withdrawal step two: submission",
        "parameters": [
          {
            "name": "x-publishable-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "withdrawal": {
                      "$ref": "#/components/schemas/Withdrawal"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown, wrong token or already confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "type",
          "message"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable code, see the list in docs/frontend-api.en.mdx.",
            "examples": [
              "consent_required",
              "consent_version_outdated",
              "external_marketplace_order"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Omnibus": {
        "type": "object",
        "required": [
          "status",
          "is_reduced",
          "reference_price",
          "reference_label",
          "reduction_percent"
        ],
        "properties": {
          "status": {
            "enum": [
              "ok",
              "no_price",
              "exempt"
            ]
          },
          "current_amount": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "original_amount": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "is_reduced": {
            "type": "boolean"
          },
          "price_list_id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reduction_started_at": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "reference_price": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "reference_basis": {
            "oneOf": [
              {
                "enum": [
                  "lowest_in_window",
                  "lowest_since_first_offered",
                  "price_before_first_reduction"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "reference_label": {
            "oneOf": [
              {
                "enum": [
                  "lowest_30_days",
                  "lowest_since_introduction",
                  "price_before_reduction"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "reference_label_text": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "window_days": {
            "type": "integer"
          },
          "window_start": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "window_end": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "offered_less_than_window": {
            "type": "boolean"
          },
          "history_incomplete": {
            "type": "boolean"
          },
          "reduction_percent": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "reference_not_higher": {
            "type": "boolean"
          },
          "lowest_price_in_window": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "oneOf": [
              {
                "enum": [
                  "no_prior_price"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "UnitPrice": {
        "type": "object",
        "required": [
          "amount",
          "reference_unit",
          "reference_label"
        ],
        "properties": {
          "amount": {
            "type": "number"
          },
          "reference_unit": {
            "enum": [
              "kg",
              "per_100g",
              "l",
              "per_100ml",
              "m",
              "m2",
              "m3",
              "piece",
              "per_10_pieces",
              "per_100_pieces"
            ]
          },
          "reference_label": {
            "type": "string"
          },
          "based_on": {
            "enum": [
              "net_quantity",
              "drained_quantity"
            ]
          },
          "same_as_price": {
            "type": "boolean"
          }
        }
      },
      "VariantCompliance": {
        "type": "object",
        "required": [
          "variant_id",
          "currency_code",
          "omnibus"
        ],
        "properties": {
          "variant_id": {
            "type": "string"
          },
          "currency_code": {
            "type": "string"
          },
          "tax_inclusive": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "omnibus": {
            "$ref": "#/components/schemas/Omnibus"
          },
          "unit_price": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UnitPrice"
              },
              {
                "type": "null"
              }
            ]
          },
          "deposit": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number"
                  },
                  "currency_code": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Operator": {
        "type": "object",
        "properties": {
          "name": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "trade_name": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "postal_address": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "country_code": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "email": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Safety": {
        "type": "object",
        "required": [
          "applicable"
        ],
        "properties": {
          "applicable": {
            "type": "boolean"
          },
          "manufacturer": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Operator"
              },
              {
                "type": "null"
              }
            ]
          },
          "responsible_person": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Operator"
              },
              {
                "type": "null"
              }
            ]
          },
          "product_identifier": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "variant_identifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "variant_id": {
                  "type": "string"
                },
                "sku": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "barcode": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "ean": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "upc": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "warnings": {
